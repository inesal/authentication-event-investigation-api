# Local development only. Never use these values in a deployed environment.
APP_NAME=Authentication Event Investigation API
APP_VERSION=1.0.0
API_PREFIX=/api/v1
LOG_LEVEL=INFO
SLOW_REQUEST_MS=500
CORS_ORIGINS=http://localhost,http://localhost:8000

POSTGRES_DB=lanl
POSTGRES_USER=lanl
POSTGRES_PASSWORD=change-this-local-password
DATABASE_URL=postgresql+asyncpg://lanl:change-this-local-password@db:5432/lanl

UVICORN_WORKERS=3
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=20
